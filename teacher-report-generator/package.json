{
  "name": "ican-stellar-report-generator",
  "version": "1.0.0",
  "description": "ICAN STELLAR DAILY REPORT with AI-powered narrative generation",
  "main": "electron-main.js",
  "scripts": {
    "start": "node api.js",
    "dev": "nodemon api.js",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "build-all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.ican.stellar.report",
    "productName": "ICAN STELLAR DAILY REPORT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules",
      "!dist",
      "!README.md"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@notionhq/client": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^4.20.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "nodemon": "^3.0.1",
    "wait-on": "^7.0.1"
  }
}
